<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/o_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Ocorrências perto" android:textColor="#E6E1E5" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
  <TextView android:id="@+id/o_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#938F99" android:textSize="12sp" />
</LinearLayout>
<LinearLayout android:id="@+id/o_row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
  <TextView android:id="@+id/o_i0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚨" android:textColor="#E6E1E5" android:textSize="20sp" android:layout_marginEnd="10dp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/o_t0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#E6E1E5" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/o_s0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#938F99" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/o_d0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#E6E1E5" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/o_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
  <TextView android:id="@+id/o_i1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚨" android:textColor="#E6E1E5" android:textSize="20sp" android:layout_marginEnd="10dp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/o_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#E6E1E5" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/o_s1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#938F99" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/o_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#E6E1E5" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
</LinearLayout>
<TextView android:id="@+id/o_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A carregar ocorrências…" android:textColor="#938F99" android:textSize="12sp" android:layout_marginTop="8dp" android:maxLines="1"/>
</LinearLayout>
