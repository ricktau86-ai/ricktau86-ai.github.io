<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp" >
<TextView android:id="@+id/t_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tempo" android:textColor="#938F99" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/t_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#E6E1E5" android:textSize="34sp" android:fontFamily="sans-serif-light" android:layout_marginEnd="8dp"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/t_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A carregar…" android:textColor="#E6E1E5" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/t_minmax" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#938F99" android:textSize="12sp" android:maxLines="1"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
    <TextView android:id="@+id/t_rain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#4FC3F7" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/t_gust" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#CAC4D0" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/t_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#938F99" android:textSize="11sp" android:maxLines="1"/>
  </LinearLayout>
</LinearLayout>
</LinearLayout>
